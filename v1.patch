+            {"id": "SH2", "name": "Supplement", "altitude_km": 600, "inclination_deg": 70, "planes": 2, "sats_per_plane": 2, "phasing": 1, "j2": True},
+        ],
+        "duration_min": 10,
+        "step_sec": 120,
+        "stations": [{"name": "Seoul", "lat_deg": 37.5665, "lon_deg": 126.9780, "min_elevation_deg": 20}],
+    }
+    simulation = client.post("/api/multi-shell/simulate", json=payload)
+    assert simulation.status_code == 200, simulation.text
