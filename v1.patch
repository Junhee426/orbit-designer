@@ -0,0 +1,148 @@
+from __future__ import annotations
+
+import math
+
+import numpy as np
+
+from .constants import R_EARTH_KM
+from .constellation import satellite_ids, satellite_positions_eci
+from .models import ConstellationConfig
+from .orbit import ecef_to_latlon, eci_to_ecef
+
+
+def minimum_elevation_footprint_central_angle_rad(altitude_km: float, min_elevation_deg: float) -> float:
+    """Spherical-Earth footprint half-angle for a minimum ground elevation.
+
+    psi = acos((R_E / (R_E + h)) cos(E)) - E
+
+    ``min_elevation_deg`` is allowed to be slightly negative because the public
+    API already permits -5 deg for engineering sensitivity studies.
+    """
+    altitude_km = float(altitude_km)
+    if altitude_km <= 0.0:
+        raise ValueError("Altitude must be positive for footprint geometry.")
+    elevation = math.radians(float(min_elevation_deg))
+    ratio = R_EARTH_KM / (R_EARTH_KM + altitude_km)
+    arg = max(-1.0, min(1.0, ratio * math.cos(elevation)))
+    psi = math.acos(arg) - elevation
+    return max(0.0, min(math.pi, psi))
+
+
+def minimum_elevation_footprint(altitude_km: float, min_elevation_deg: float) -> dict:
+    psi = minimum_elevation_footprint_central_angle_rad(altitude_km, min_elevation_deg)
+    return {
+        "altitude_km": float(altitude_km),
+        "min_elevation_deg": float(min_elevation_deg),
+        "central_angle_deg": float(math.degrees(psi)),
+        "surface_radius_km": float(R_EARTH_KM * psi),
+    }
+
+
+def footprint_polygon_lon_lat_deg(
+    center_lat_deg: float,
+    center_lon_deg: float,
+    central_angle_rad: float,
+    samples: int = 72,
+) -> list[list[float]]:
+    """Return a closed small-circle polygon around a sub-satellite point."""
+    samples = max(24, min(int(samples), 360))
+    lat1 = math.radians(float(center_lat_deg))
+    lon1 = math.radians(float(center_lon_deg))
+    delta = float(central_angle_rad)
+    sin_lat1, cos_lat1 = math.sin(lat1), math.cos(lat1)
+    sin_d, cos_d = math.sin(delta), math.cos(delta)
+    points: list[list[float]] = []
+    for bearing in np.linspace(0.0, 2.0 * math.pi, samples, endpoint=False):
+        lat2 = math.asin(max(-1.0, min(1.0, sin_lat1 * cos_d + cos_lat1 * sin_d * math.cos(float(bearing)))))
+        lon2 = lon1 + math.atan2(
+            math.sin(float(bearing)) * sin_d * cos_lat1,
+            cos_d - sin_lat1 * math.sin(lat2),
+        )
+        lon_deg = (math.degrees(lon2) + 180.0) % 360.0 - 180.0
+        points.append([float(lon_deg), float(math.degrees(lat2))])
+    if points:
+        points.append(points[0].copy())
+    return points
+
+
+def _satellite_index(cfg: ConstellationConfig, satellite_id: str) -> int:
+    ids = satellite_ids(cfg)
+    try:
+        return ids.index(str(satellite_id))
+    except ValueError as exc:
+        raise ValueError(f"Unknown Walker satellite id: {satellite_id}.") from exc
+
+
+def walker_ground_track(
+    cfg: ConstellationConfig,
+    satellite_id: str,
+    time_sec: float,
+    span_min: float = 220.0,
+    samples: int = 181,
+) -> dict:
+    """Propagate one Walker satellite and split longitude discontinuities."""
+    idx = _satellite_index(cfg, satellite_id)
+    samples = max(24, min(int(samples), 720))
+    span_sec = max(1.0, float(span_min) * 60.0)
+    times = np.linspace(float(time_sec) - span_sec / 2.0, float(time_sec) + span_sec / 2.0, samples)
+    lon_lat: list[list[float]] = []
+    for t in times:
+        eci = satellite_positions_eci(cfg, float(t))[idx]
+        ecef = eci_to_ecef(eci, float(t))
+        lat, lon = ecef_to_latlon(ecef)
+        lon_lat.append([float(lon), float(lat)])
+
+    segments: list[list[list[float]]] = []
+    current: list[list[float]] = []
+    previous_lon: float | None = None
+    for point in lon_lat:
+        lon = point[0]
+        if previous_lon is not None and abs(lon - previous_lon) > 180.0:
+            if current:
+                segments.append(current)
+            current = []
+        current.append(point)
+        previous_lon = lon
+    if current:
+        segments.append(current)
+
+    return {
+        "span_min": float(span_min),
+        "samples": int(samples),
+        "start_time_sec": float(times[0]),
+        "end_time_sec": float(times[-1]),
+        "segments_lon_lat_deg": segments,
+    }
+
+
+def walker_orbital_geometry(
+    cfg: ConstellationConfig,
+    satellite_id: str,
+    time_sec: float,
+    *,
+    min_elevation_deg: float = 20.0,
+    ground_track_span_min: float = 220.0,
+    ground_track_samples: int = 181,
+    footprint_samples: int = 72,
+) -> dict:
+    idx = _satellite_index(cfg, satellite_id)
+    pos_eci = satellite_positions_eci(cfg, float(time_sec))[idx]
+    pos_ecef = eci_to_ecef(pos_eci, float(time_sec))
+    lat, lon = ecef_to_latlon(pos_ecef)
+    footprint = minimum_elevation_footprint(cfg.altitude_km, min_elevation_deg)
+    footprint["center_lat_deg"] = float(lat)
+    footprint["center_lon_deg"] = float(lon)
+    footprint["lon_lat_deg"] = footprint_polygon_lon_lat_deg(
+        float(lat), float(lon), math.radians(footprint["central_angle_deg"]), footprint_samples
+    )
+    return {
+        "mode": "walker",
+        "satellite_id": str(satellite_id),
+        "time_sec": float(time_sec),
+        "subpoint": {"lat_deg": float(lat), "lon_deg": float(lon)},
+        "position_ecef_km": [float(x) for x in pos_ecef],
+        "ground_track": walker_ground_track(
+            cfg, satellite_id, time_sec, ground_track_span_min, ground_track_samples
+        ),
+        "footprint": footprint,
+    }
diff --git a/app/core/multishell.py b/app/core/multishell.py
new file mode 100644
--- /dev/null
+++ b/app/core/multishell.py
@@ -0,0 +1,275 @@
+from __future__ import annotations
+
+import re
+from typing import Iterable
+
+import numpy as np
+
+from .constellation import satellite_ids, satellite_positions_eci
+from .geometry import walker_orbital_geometry
+from .ground import elevation_and_range
+from .heatmap import instantaneous_coverage_heatmaps
+from .models import ConstellationConfig, GroundStation
+from .orbit import eci_to_ecef
+from .snapshot import walker_snapshot
+from .visualization import access_links
+
+ShellConfig = tuple[str, str, ConstellationConfig]
+
+
+def normalize_shell_id(value: str | None, index: int = 0) -> str:
+    raw = (value or "").strip().upper()
+    raw = re.sub(r"[^A-Z0-9_-]+", "-", raw).strip("-_")
+    return raw or f"SH{int(index) + 1}"
+
+
+def _prefixed_id(shell_id: str, local_id: str) -> str:
+    return f"{shell_id}-{local_id}"
+
+
+def _shell_payload(shell_id: str, shell_name: str, cfg: ConstellationConfig) -> dict:
+    return {
+        "id": shell_id,
+        "name": shell_name,
+        **cfg.to_dict(),
+        "total_satellites": cfg.total_satellites,
+    }
+
+
+def _combined_state(shells: Iterable[ShellConfig], t_sec: float):
+    shell_list = list(shells)
+    if not shell_list:
+        raise ValueError("Multi-shell mode requires at least one shell.")
+    sat_ids_all: list[str] = []
+    ecef_blocks: list[np.ndarray] = []
+    for shell_id, _shell_name, cfg in shell_list:
+        local_ids = satellite_ids(cfg)
+        sat_ids_all.extend(_prefixed_id(shell_id, x) for x in local_ids)
+        eci = satellite_positions_eci(cfg, float(t_sec))
+        ecef_blocks.append(eci_to_ecef(eci, float(t_sec)))
+    return shell_list, sat_ids_all, np.concatenate(ecef_blocks, axis=0)
+
+
+def multi_shell_snapshot(
+    shells: Iterable[ShellConfig],
+    t_sec: float,
+    min_elevation_deg: float = 20.0,
+    heatmap: bool = True,
+    heatmap_points: int = 28,
+    stations: Iterable[GroundStation] | None = None,
+    include_orbits: bool = True,
+    include_isl: bool = True,
+    include_access: bool = True,
+    orbit_samples: int = 96,
+    coverage_areas: list[dict] | None = None,
+) -> dict:
+    shell_list = list(shells)
+    if not shell_list:
+        raise ValueError("Multi-shell mode requires at least one shell.")
+
+    satellites: list[dict] = []
+    orbits: list[dict] = []
+    isl_links: list[dict] = []
+    combined_ids: list[str] = []
+    ecef_blocks: list[np.ndarray] = []
+
+    for shell_id, shell_name, cfg in shell_list:
+        snap = walker_snapshot(
+            cfg,
+            float(t_sec),
+            min_elevation_deg=min_elevation_deg,
+            heatmap=False,
+            stations=[],
+            include_orbits=include_orbits,
+            include_isl=include_isl,
+            include_access=False,
+            orbit_samples=orbit_samples,
+            coverage_areas=[],
+        )
+        for sat in snap["satellites"]:
+            local_id = sat["id"]
+            global_id = _prefixed_id(shell_id, local_id)
+            item = dict(sat)
+            item.update({
+                "id": global_id,
+                "name": global_id,
+                "source": "Multi-shell Walker",
+                "local_id": local_id,
+                "shell_id": shell_id,
+                "shell_name": shell_name,
+            })
+            satellites.append(item)
+            combined_ids.append(global_id)
+        ecef_blocks.append(np.asarray([
+            [x["ecef_x_km"], x["ecef_y_km"], x["ecef_z_km"]] for x in snap["satellites"]
+        ], dtype=float))
+
+        for path in snap["visualization"]["orbits"]:
+            item = dict(path)
+            item["id"] = f"{shell_id}-{path['id']}"
+            item["shell_id"] = shell_id
+            item["shell_name"] = shell_name
+            orbits.append(item)
+        for link in snap["visualization"]["isl_links"]:
+            item = dict(link)
+            item["a_id"] = _prefixed_id(shell_id, link["a_id"])
+            item["b_id"] = _prefixed_id(shell_id, link["b_id"])
+            item["shell_id"] = shell_id
+            item["shell_name"] = shell_name
+            isl_links.append(item)
+
+    all_ecef = np.concatenate(ecef_blocks, axis=0)
+    heatmaps = instantaneous_coverage_heatmaps(
+        all_ecef, coverage_areas, min_elevation_deg, heatmap_points
+    ) if heatmap else []
+    station_list = list(stations or [])
+    combined_access = access_links(all_ecef, combined_ids, station_list) if include_access and station_list else []
+
+    return {
+        "mode": "multi_shell",
+        "time_sec": float(t_sec),
+        "shells": [_shell_payload(*x) for x in shell_list],
+        "total_satellites": len(satellites),
+        "satellites": satellites,
+        "heatmap": heatmaps[0] if heatmaps else None,
+        "heatmaps": heatmaps,
+        "visualization": {
+            "orbits": orbits if include_orbits else [],
+            "isl_links": isl_links if include_isl else [],
+            "access_links": combined_access,
+            "isl_scope": "intra-shell only",
+        },
+        "errors": [],
+    }
+
+
+def _station_timelines(
+    shells: list[ShellConfig],
+    stations: list[GroundStation],
+    duration_min: float,
+    step_sec: float,
+) -> list[dict]:
+    times = np.arange(0.0, float(duration_min) * 60.0 + 0.1, float(step_sec))
+    records = [{
+        "station": st,
+        "visible_counts": [],
+        "best_elevation": [],
+        "best_ids": [],
+        "ranges": [],
+    } for st in stations]
+
+    for t in times:
+        _shells, ids, ecef = _combined_state(shells, float(t))
+        for rec in records:
+            st = rec["station"]
+            elev, rng = elevation_and_range(ecef, st)
+            finite = np.isfinite(elev) & np.isfinite(rng)
+            visible = finite & (elev >= st.min_elevation_deg)
+            rec["visible_counts"].append(int(visible.sum()))
+            rec["best_elevation"].append(float(np.nanmax(elev)) if np.any(finite) else None)
+            if np.any(visible):
+                candidates = np.where(visible)[0]
+                best = int(candidates[np.argmax(elev[candidates])])
+                rec["best_ids"].append(ids[best])
+                rec["ranges"].append(float(rng[best]))
+            else:
+                rec["best_ids"].append(None)
+                rec["ranges"].append(None)
+
+    result: list[dict] = []
+    for rec in records:
+        counts = np.asarray(rec["visible_counts"], dtype=int)
+        handovers = 0
+        previous = None
+        for sat_id in rec["best_ids"]:
+            if sat_id is None:
+                continue
+            if previous is not None and sat_id != previous:
+                handovers += 1
+            previous = sat_id
+        duration_hr = (float(times[-1] - times[0]) / 3600.0) if len(times) > 1 else 0.0
+        max_run = current = 0
+        for count in counts:
+            if count == 0:
+                current += 1
+                max_run = max(max_run, current)
+            else:
+                current = 0
+        st = rec["station"]
+        result.append({
+            "name": st.name,
+            "lat_deg": st.lat_deg,
+            "lon_deg": st.lon_deg,
+            "min_elevation_deg": st.min_elevation_deg,
+            "times_sec": times.tolist(),
+            "visible_counts": rec["visible_counts"],
+            "best_elevation_deg": rec["best_elevation"],
+            "best_satellite_ids": rec["best_ids"],
+            "best_slant_range_km": rec["ranges"],
+            "availability": float(np.mean(counts > 0)) if len(counts) else 0.0,
+            "avg_visible": float(np.mean(counts)) if len(counts) else 0.0,
+            "max_visible": int(counts.max()) if len(counts) else 0,
+            "handover_count": int(handovers),
+            "handovers_per_hour": float(handovers / duration_hr) if duration_hr > 0 else 0.0,
+            "max_sampled_outage_sec": float(max_run * float(step_sec)),
+        })
+    return result
+
+
+def run_multi_shell_simulation(
+    shells: Iterable[ShellConfig],
+    stations: Iterable[GroundStation],
+    duration_min: float = 120.0,
+    step_sec: float = 60.0,
+) -> dict:
+    shell_list = list(shells)
+    station_list = list(stations)
+    if not shell_list:
+        raise ValueError("Multi-shell mode requires at least one shell.")
+    timelines = _station_timelines(shell_list, station_list, duration_min, step_sec)
+    summary = {
+        "mean_availability": float(np.mean([x["availability"] for x in timelines])) if timelines else 0.0,
+        "worst_availability": float(np.min([x["availability"] for x in timelines])) if timelines else 0.0,
+        "mean_visible": float(np.mean([x["avg_visible"] for x in timelines])) if timelines else 0.0,
+        "mean_handovers_per_hour": float(np.mean([x["handovers_per_hour"] for x in timelines])) if timelines else 0.0,
+        "worst_sampled_outage_sec": float(np.max([x["max_sampled_outage_sec"] for x in timelines])) if timelines else 0.0,
+    }
+    snap = multi_shell_snapshot(
+        shell_list, 0.0, min_elevation_deg=20.0, heatmap=False,
+        stations=station_list, include_orbits=False, include_isl=True, include_access=True,
+    )
+    return {
+        "mode": "multi_shell",
+        "shells": [_shell_payload(*x) for x in shell_list],
+        "total_satellites": sum(cfg.total_satellites for _sid, _name, cfg in shell_list),
+        "coverage_summary": summary,
+        "station_timelines": timelines,
+        "snapshot": snap["satellites"],
+        "isl": {
+            "scope": "intra-shell only",
+            "active_edges": len(snap["visualization"]["isl_links"]),
+        },
+    }
+
+
+def multi_shell_orbital_geometry(
+    shells: Iterable[ShellConfig],
+    satellite_id: str,
+    time_sec: float,
+    **kwargs,
+) -> dict:
+    shell_list = list(shells)
+    for shell_id, shell_name, cfg in shell_list:
+        prefix = f"{shell_id}-"
+        if str(satellite_id).startswith(prefix):
+            local_id = str(satellite_id)[len(prefix):]
+            geometry = walker_orbital_geometry(cfg, local_id, time_sec, **kwargs)
+            geometry.update({
+                "mode": "multi_shell",
+                "satellite_id": str(satellite_id),
+                "local_satellite_id": local_id,
+                "shell_id": shell_id,
+                "shell_name": shell_name,
+            })
+            return geometry
+    raise ValueError(f"Unknown multi-shell satellite id: {satellite_id}.")
