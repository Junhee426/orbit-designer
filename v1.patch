+import pytest
+from fastapi.testclient import TestClient
+
+from app.core.geometry import minimum_elevation_footprint, walker_ground_track, walker_orbital_geometry
+from app.core.models import ConstellationConfig, GroundStation
+from app.core.multishell import (
+    multi_shell_orbital_geometry,
+    multi_shell_snapshot,
+    normalize_shell_id,
+    run_multi_shell_simulation,
+)
+from app.main import app
+
+
+def _small_shells():
+    return [
+        ("SH1", "Core", ConstellationConfig(1280, 42, 2, 3, 1, True)),
+        ("SH2", "Supplement", ConstellationConfig(600, 70, 2, 2, 1, True)),
+    ]
+
+
+def test_footprint_matches_v110_validation_reference():
+    footprint = minimum_elevation_footprint(1280.0, 20.0)
+    assert footprint["central_angle_deg"] == pytest.approx(18.4979833636, abs=1e-9)
+    assert footprint["surface_radius_km"] == pytest.approx(2059.1860887, abs=1e-6)
+
+
+def test_footprint_shrinks_as_minimum_elevation_increases():
+    low = minimum_elevation_footprint(1280.0, 0.0)["surface_radius_km"]
+    nominal = minimum_elevation_footprint(1280.0, 20.0)["surface_radius_km"]
+    high = minimum_elevation_footprint(1280.0, 30.0)["surface_radius_km"]
+    assert low > nominal > high > 0.0
+
+
+def test_default_ground_track_is_dateline_safe():
+    cfg = ConstellationConfig(1280, 42, 8, 16, 1, True)
+    track = walker_ground_track(cfg, "P01-S01", 0.0, span_min=220.0, samples=181)
+    assert track["samples"] == 181
+    assert len(track["segments_lon_lat_deg"]) == 3
+    for segment in track["segments_lon_lat_deg"]:
+        for a, b in zip(segment, segment[1:]):
+            assert abs(b[0] - a[0]) <= 180.0
+
+
+def test_unknown_walker_satellite_is_rejected():
+    cfg = ConstellationConfig(1280, 42, 8, 16, 1, True)
+    with pytest.raises(ValueError, match="Unknown Walker satellite id"):
+        walker_orbital_geometry(cfg, "P99-S99", 0.0)
+
+
+def test_shell_id_normalization_is_deterministic():
+    assert normalize_shell_id(" shell 2 ") == "SHELL-2"
+    assert normalize_shell_id("", 1) == "SH2"
+    assert normalize_shell_id("my/shell") == "MY-SHELL"
+
+
+def test_multi_shell_snapshot_has_unique_prefixed_satellites():
+    snap = multi_shell_snapshot(
+        _small_shells(), 0.0, heatmap=False, stations=[],
+        include_orbits=False, include_isl=False, include_access=False,
+    )
+    ids = [sat["id"] for sat in snap["satellites"]]
+    assert snap["mode"] == "multi_shell"
+    assert snap["total_satellites"] == 10
+    assert len(ids) == len(set(ids)) == 10
+    assert all(sat["source"] == "Multi-shell Walker" for sat in snap["satellites"])
+    assert any(x.startswith("SH1-") for x in ids)
+    assert any(x.startswith("SH2-") for x in ids)
+
+
+def test_multi_shell_isl_links_stay_within_shells():
+    snap = multi_shell_snapshot(
+        _small_shells(), 0.0, heatmap=False, stations=[],
+        include_orbits=False, include_isl=True, include_access=False,
+    )
+    assert snap["visualization"]["isl_scope"] == "intra-shell only"
+    for link in snap["visualization"]["isl_links"]:
+        prefix = f"{link['shell_id']}-"
+        assert link["a_id"].startswith(prefix)
+        assert link["b_id"].startswith(prefix)
+
+
+def test_multi_shell_simulation_combines_station_visibility():
+    station = GroundStation("Seoul", 37.5665, 126.9780, 20.0)
+    result = run_multi_shell_simulation(_small_shells(), [station], duration_min=10.0, step_sec=120.0)
+    assert result["mode"] == "multi_shell"
+    assert result["total_satellites"] == 10
+    assert len(result["station_timelines"]) == 1
+    assert 0.0 <= result["coverage_summary"]["mean_availability"] <= 1.0
+    assert result["isl"]["scope"] == "intra-shell only"
+
+
+def test_multi_shell_orbital_geometry_selects_requested_shell():
+    geometry = multi_shell_orbital_geometry(
+        _small_shells(), "SH2-P01-S01", 0.0,
+        min_elevation_deg=20.0, ground_track_samples=48, footprint_samples=36,
+    )
+    assert geometry["mode"] == "multi_shell"
+    assert geometry["shell_id"] == "SH2"
+    assert geometry["local_satellite_id"] == "P01-S01"
+    assert geometry["satellite_id"] == "SH2-P01-S01"
+    assert geometry["footprint"]["altitude_km"] == 600.0
+
